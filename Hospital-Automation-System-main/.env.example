APP_ENV=development
DEMO_MODE=true
ATTENDANCE_MODE=demo

# Database (preferred)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hospital_automation

# Alternate PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# NVIDIA API
NVIDIA_API_KEY=

# Gemini image proof verification
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# SOP LLM Planner
ENABLE_SOP_LLM_PLANNER=true

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# WhatsApp Integration
WHATSAPP_MOCK=true
WHATSAPP_VERIFY_TOKEN=hospital_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
